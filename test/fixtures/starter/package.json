{
    "name": "@fleetbase/starter-engine",
    "version": "0.0.1",
    "description": "Starter Extension for Fleetbasee",
    "keywords": [
        "fleetbase-extension",
        "fleetbase",
        "ember-addon",
        "ember-engine"
    ],
    "fleetbase": {
        "route": "starter"
    },
    "repository": "https://github.com/fleetbase/starter-extension",
    "license": "AGPL-3.0-or-later",
    "author": "Fleetbase Pte Ltd <hello@fleetbase.io>",
    "directories": {
        "app": "app",
        "addon": "addon",
        "tests": "tests"
    },
    "scripts": {
        "build": "ember build --environment=production",
        "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\"",
        "lint:css": "stylelint \"**/*.css\"",
        "lint:css:fix": "concurrently \"npm:lint:css -- --fix\"",
        "lint:fix": "concurrently \"npm:lint:*:fix\" --names \"fix:\"",
        "lint:hbs": "ember-template-lint .",
        "lint:hbs:fix": "ember-template-lint . --fix",
        "lint:js": "eslint . --cache",
        "lint:js:fix": "eslint . --fix",
        "start": "ember serve",
        "test": "concurrently \"npm:lint\" \"npm:test:*\" --names \"lint,test:\"",
        "test:ember": "ember test",
        "test:ember-compatibility": "ember try:each",
        "publish:npm": "npm config set registry https://registry.npmjs.org/ && npm publish",
        "publish:github": "npm config set '@fleetbase:registry' https://npm.pkg.github.com/ && npm publish"
    },
    "dependencies": {},
    "devDependencies": {},
    "peerDependencies": {
        "ember-engines": "^0.9.0"
    },
    "engines": {
        "node": ">= 18"
    },
    "ember": {
        "edition": "octane"
    },
    "ember-addon": {
        "configPath": "tests/dummy/config"
    },
    "prettier": {
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": true,
        "singleQuote": true,
        "printWidth": 190,
        "overrides": [
            {
                "files": "*.hbs",
                "options": {
                    "singleQuote": false
                }
            }
        ]
    }
}

{
    "name": "@fleetbase/cli",
    "version": "2.0.0-beta.0",
    "description": "Fleetbase CLI: publish extensions to the Fleetbase Extensions Registry and manage installs on your instances",
    "repository": "https://github.com/fleetbase/fleetbase-cli",
    "license": "AGPL-3.0-or-later",
    "author": "Fleetbase Pte Ltd <hello@fleetbase.io>",
    "keywords": [
        "fleetbase",
        "fleetbase-cli",
        "fleetbase-extensions"
    ],
    "type": "module",
    "bin": {
        "flb": "dist/bin/flb.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "engines": {
        "node": ">=20.10"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "npm run build && bash test/e2e/run.sh",
        "prepack": "npm run clean && npm run build"
    },
    "dependencies": {
        "commander": "^14.0.3",
        "enquirer": "^2.4.1",
        "picocolors": "^1.1.1",
        "semver": "^7.7.2",
        "tar": "^7.4.3"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "@types/semver": "^7.7.0",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}
